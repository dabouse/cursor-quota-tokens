{
  "name": "cursor-quota-tokens",
  "displayName": "Cursor Quota & Token Monitor",
  "description": "Real-time monitor for Cursor fast requests, reset countdown, Grok/Sand weekly quota, and detailed token metrics.",
  "version": "1.0.14",
  "publisher": "isArray",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dabouse/cursor-quota-tokens.git"
  },
  "bugs": {
    "url": "https://github.com/dabouse/cursor-quota-tokens/issues"
  },
  "homepage": "https://github.com/dabouse/cursor-quota-tokens#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "cursor",
    "quota",
    "token",
    "tokens",
    "usage",
    "monitor",
    "tracker",
    "claude",
    "gpt-4"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursor-quota-tokens-view",
          "title": "Cursor Quota",
          "icon": "images/statusbar-icon.svg"
        }
      ]
    },
    "views": {
      "cursor-quota-tokens-view": [
        {
          "type": "webview",
          "id": "cursorQuota.dashboard",
          "name": "Usage dashboard"
        }
      ]
    },
    "commands": [
      {
        "command": "cursorQuota.refresh",
        "title": "Refresh Cursor Quota & Tokens",
        "category": "Cursor Quota",
        "icon": "$(refresh)"
      },
      {
        "command": "cursorQuota.openDashboard",
        "title": "Open Cursor Usage Dashboard",
        "category": "Cursor Quota",
        "icon": "$(dashboard)"
      },
      {
        "command": "cursorQuota.setToken",
        "title": "Set Cursor Session Token Manually",
        "category": "Cursor Quota"
      },
      {
        "command": "cursorQuota.clearToken",
        "title": "Clear Custom Session Token",
        "category": "Cursor Quota"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cursorQuota.refresh",
          "when": "view == cursorQuota.dashboard",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Cursor Quota & Token Monitor",
      "properties": {
        "cursorQuota.refreshInterval": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 120,
          "description": "Automatic background refresh interval in minutes (1–120)."
        },
        "cursorQuota.statusBarFormat": {
          "type": "string",
          "enum": [
            "requests_and_tokens",
            "requests_only",
            "percent_only",
            "tokens_only"
          ],
          "enumDescriptions": [
            "Remaining requests and today's tokens (for example: ⚡ 0/2000 | 61.2M tok)",
            "Fast requests only (for example: ⚡ 0/2000)",
            "Remaining percent only (for example: ⚡ 12% left)",
            "Today's tokens only (for example: ⚡ 61.2M tok)"
          ],
          "default": "requests_and_tokens",
          "description": "Status bar display format."
        },
        "cursorQuota.lowQuotaThreshold": {
          "type": "number",
          "default": 15,
          "description": "Low-quota warning threshold, as a remaining percentage. The status bar turns yellow or red below this value."
        }
      }
    }
  },
  "scripts": {
    "test": "node -c extension.js && node -c src/cursor_auth.js && node -c src/cursor_api.js && node -c src/token_aggregator.js && node -c src/status_bar.js && node -c src/webview_provider.js && node -c src/views/panel.js",
    "package": "npx @vscode/vsce package --no-dependencies -o releases/"
  }
}
